{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "asOf", "sourceUrls", "schools"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "sourceUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "schools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "prefectureCode", "prefecture", "address", "postalCode", "ownership", "campusType", "openedOn", "lastVerifiedAt", "tags"],
        "properties": {
          "id": { "type": "string", "pattern": "^wk_d1[0-9]{11}$" },
          "name": { "type": "string", "minLength": 1 },
          "nameKana": { "type": "string" },
          "prefectureCode": { "type": "string", "pattern": "^[0-9]{2}$" },
          "prefecture": { "type": "string" },
          "address": { "type": "string" },
          "postalCode": { "type": "string" },
          "ownership": { "enum": ["national", "public", "private", "unknown"] },
          "campusType": { "enum": ["main", "branch"] },
          "openedOn": { "type": "string" },
          "lastVerifiedAt": { "type": "string", "format": "date" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "officialUrl": { "type": "string", "format": "uri" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
