{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wakaroute.com/schemas/school-past-exams.schema.json",
  "title": "WakaRoute school to official past exam association rules",
  "type": "object",
  "required": ["schemaVersion", "asOf", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pastExamSourceIds"],
        "properties": {
          "pastExamSourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "prefectureCode": { "type": "string", "pattern": "^[0-9]{2}$" },
          "ownership": { "enum": ["national", "public", "private", "unknown"] },
          "schoolNamePrefix": { "type": "string", "minLength": 1 }
        },
        "anyOf": [
          { "required": ["prefectureCode"] },
          { "required": ["ownership"] },
          { "required": ["schoolNamePrefix"] }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
