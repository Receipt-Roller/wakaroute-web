{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WakaRoute annual school exam schedules",
  "type": "object",
  "required": ["schemaVersion", "academicYear", "schedules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "academicYear": { "type": "integer", "minimum": 2000 },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schoolId", "academicYear", "selection", "selectionLabel", "status", "statusLabel", "applicationPeriod", "testDates", "resultDate", "detailsStatus", "detailsStatusLabel", "verifiedAt", "notes", "sources"],
        "properties": {
          "schoolId": { "type": "string", "pattern": "^wk_" },
          "testDates": { "type": "array" },
          "sources": { "type": "array", "minItems": 1 }
        }
      }
    },
    "sharedSchedules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schoolIds", "academicYear", "selection", "selectionLabel", "status", "statusLabel", "applicationPeriod", "testDates", "resultDate", "detailsStatus", "detailsStatusLabel", "verifiedAt", "notes", "sources"],
        "properties": {
          "schoolIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^wk_" } },
          "testDates": { "type": "array" },
          "sources": { "type": "array", "minItems": 1 }
        }
      }
    }
  }
}
