{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WakaRoute school decision guides",
  "type": "object",
  "required": ["schemaVersion", "guides"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "guides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schoolId", "summary", "verifiedAt", "highlights", "goodFit", "questionsToConsider", "access", "visitEvents", "sources"],
        "properties": {
          "schoolId": { "type": "string", "pattern": "^wk_" },
          "summary": { "type": "string", "minLength": 1 },
          "verifiedAt": { "type": "string", "format": "date" },
          "highlights": { "type": "array", "minItems": 1 },
          "goodFit": { "type": "array", "minItems": 1 },
          "questionsToConsider": { "type": "array", "minItems": 1 },
          "visitEvents": { "type": "array" },
          "sources": { "type": "array", "minItems": 1 }
        }
      }
    }
  }
}
