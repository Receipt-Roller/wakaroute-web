@inject Microsoft.AspNetCore.Routing.LinkGenerator LinkGenerator
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using System.Text.Json
@using wakaroute_web.Models
@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "高校受験の学習コーチ";
    var pageDescription = ViewData["Description"]?.ToString()
        ?? "ワカルートは、つまずきを細かく見つけ、志望校合格までの学習ルートをつくる高校受験コーチです。";
    var canonicalPath = LinkGenerator.GetPathByAction(
        Context,
        action: ViewContext.RouteData.Values["action"]?.ToString(),
        controller: ViewContext.RouteData.Values["controller"]?.ToString()) ?? Context.Request.Path.Value ?? "/";
    var siteBaseUrl = (Configuration["Site:BaseUrl"] ?? "https://wakaroute.com").TrimEnd('/');
    var canonicalUrl = $"{siteBaseUrl}{canonicalPath}";
    var fullPageTitle = $"{pageTitle} | ワカルート";
    var robots = ViewData["Robots"]?.ToString();
    var socialImageUrl = $"{siteBaseUrl}/images/wakaroute-app-icon.jpg";
    var structuredDataGraph = new List<object>
    {
        new Dictionary<string, object?>
        {
            ["@type"] = "Organization",
            ["@id"] = $"{siteBaseUrl}/#organization",
            ["name"] = "株式会社レシートローラー",
            ["url"] = $"{siteBaseUrl}/company",
            ["logo"] = socialImageUrl
        },
        new Dictionary<string, object?>
        {
            ["@type"] = "WebSite",
            ["@id"] = $"{siteBaseUrl}/#website",
            ["name"] = "ワカルート",
            ["url"] = $"{siteBaseUrl}/",
            ["inLanguage"] = "ja-JP",
            ["publisher"] = new Dictionary<string, object?> { ["@id"] = $"{siteBaseUrl}/#organization" }
        }
    };
    if (ViewData["Breadcrumbs"] is IReadOnlyList<SeoBreadcrumb> breadcrumbs && breadcrumbs.Count > 0)
    {
        structuredDataGraph.Add(new Dictionary<string, object?>
        {
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = breadcrumbs.Select((breadcrumb, index) => new Dictionary<string, object?>
            {
                ["@type"] = "ListItem",
                ["position"] = index + 1,
                ["name"] = breadcrumb.Name,
                ["item"] = $"{siteBaseUrl}{breadcrumb.Path}"
            }).ToArray()
        });
    }
    if (ViewData["StructuredData"] is IEnumerable<object> pageStructuredData)
    {
        structuredDataGraph.AddRange(pageStructuredData);
    }
    var structuredDataJson = JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = structuredDataGraph
    });
}
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@pageDescription" />
    @if (!string.IsNullOrWhiteSpace(robots))
    {
        <meta name="robots" content="@robots" />
    }
    <meta name="theme-color" content="#173f3a" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ワカルート" />
    <meta property="og:title" content="@fullPageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@socialImageUrl" />
    <meta property="og:image:alt" content="ワカルートのアプリアイコン" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@fullPageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@socialImageUrl" />
    <title>@fullPageTitle</title>
    <script type="application/ld+json">@Html.Raw(structuredDataJson)</script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LQ03Y8487B"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-LQ03Y8487B');
    </script>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
