@model SchoolSearchViewModel
@{
    ViewData["Title"] = "高校を探す";
    ViewData["Description"] = "全国の高校を、地域、学校区分、共学区分、課程・学科、入試・見学情報から検索できます。自分に合う高校を知るための最初の一歩を始めましょう。";

    string OptionLabel(IReadOnlyList<SchoolFilterOption> options, string value) =>
        options.FirstOrDefault(option => option.Value == value)?.Label ?? value;

    Dictionary<string, string> Routes(string? without = null, int? page = null)
    {
        var routes = new Dictionary<string, string>();
        void Add(string key, string value)
        {
            if (without != key && !string.IsNullOrWhiteSpace(value)) routes[key] = value;
        }

        Add("q", Model.Criteria.Query);
        Add("prefecture", Model.Criteria.Prefecture);
        Add("ownership", Model.Criteria.Ownership);
        Add("gender", Model.Criteria.Gender);
        Add("attendanceType", Model.Criteria.AttendanceType);
        Add("department", Model.Criteria.DepartmentCategory);
        Add("recruitment", Model.Criteria.Recruitment);
        if (without != "hasAdmissions" && Model.Criteria.HasAdmissions) routes["hasAdmissions"] = "true";
        if (without != "hasExamSchedule" && Model.Criteria.HasExamSchedule) routes["hasExamSchedule"] = "true";
        if (without != "hasVisitEvents" && Model.Criteria.HasVisitEvents) routes["hasVisitEvents"] = "true";
        if (without != "hasSchoolLife" && Model.Criteria.HasSchoolLife) routes["hasSchoolLife"] = "true";
        if (Model.Criteria.Sort != "relevance") Add("sort", Model.Criteria.Sort);
        if (page.HasValue) routes["page"] = page.Value.ToString();
        return routes;
    }

    var activeFilters = new List<(string Key, string Label)>();
    if (!string.IsNullOrEmpty(Model.Criteria.Query)) activeFilters.Add(("q", $"キーワード：{Model.Criteria.Query}"));
    if (!string.IsNullOrEmpty(Model.Criteria.Prefecture)) activeFilters.Add(("prefecture", OptionLabel(Model.Prefectures, Model.Criteria.Prefecture)));
    if (!string.IsNullOrEmpty(Model.Criteria.Ownership)) activeFilters.Add(("ownership", Model.Criteria.Ownership switch { "national" => "国立", "public" => "公立", "private" => "私立", _ => Model.Criteria.Ownership }));
    if (!string.IsNullOrEmpty(Model.Criteria.Gender)) activeFilters.Add(("gender", OptionLabel(Model.Genders, Model.Criteria.Gender)));
    if (!string.IsNullOrEmpty(Model.Criteria.AttendanceType)) activeFilters.Add(("attendanceType", OptionLabel(Model.AttendanceTypes, Model.Criteria.AttendanceType)));
    if (!string.IsNullOrEmpty(Model.Criteria.DepartmentCategory)) activeFilters.Add(("department", OptionLabel(Model.DepartmentCategories, Model.Criteria.DepartmentCategory)));
    if (Model.Criteria.Recruitment == "excluding-stopped") activeFilters.Add(("recruitment", "募集停止表示なし"));
    if (Model.Criteria.Recruitment == "stopped") activeFilters.Add(("recruitment", "募集停止中"));
    if (Model.Criteria.HasAdmissions) activeFilters.Add(("hasAdmissions", "入試実績あり"));
    if (Model.Criteria.HasExamSchedule) activeFilters.Add(("hasExamSchedule", "次年度日程あり"));
    if (Model.Criteria.HasVisitEvents) activeFilters.Add(("hasVisitEvents", "見学情報あり"));
    if (Model.Criteria.HasSchoolLife) activeFilters.Add(("hasSchoolLife", "部活・学校生活あり"));
}

<section class="school-search-hero">
    <div class="shell school-search-hero-grid">
        <div>
            <nav class="breadcrumbs" aria-label="パンくずリスト">
                <a asp-controller="Home" asp-action="Index">ホーム</a><span aria-hidden="true">/</span><span>高校を探す</span>
            </nav>
            <div class="eyebrow"><span></span>SCHOOL DISCOVERY</div>
            <h1>自分に合う高校を、<br /><em>知ることから始めよう。</em></h1>
            <p>通える場所、学びたい分野、学校生活、そして入試。まだ希望が決まっていなくても大丈夫です。分かる条件から少しずつ候補を見つけていきましょう。</p>
        </div>
        <div class="school-count-card" aria-label="掲載している高校コード数">
            <small>全国の現行高校コード</small>
            <strong>@Model.Metadata.CurrentSchoolCount.ToString("N0")<span>件</span></strong>
            <p>@Model.Metadata.AsOf.Replace("-", ".") 時点<br />文部科学省「学校コード」確定版より</p>
            <div><span>47</span>都道府県 <i></i><span>@Model.Metadata.BranchCount</span>分校を含む</div>
        </div>
    </div>
</section>

<section class="school-search-section">
    <div class="shell">
        <form class="school-search-form" method="get" asp-controller="Schools" asp-action="Index">
            <div class="school-search-primary">
                <div class="school-keyword-field">
                    <label for="school-query">学校名・地域・学科・コース・駅・部活</label>
                    <div><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m16 16 4 4" /></svg><input id="school-query" name="q" value="@Model.Criteria.Query" placeholder="例：松本、情報、赤坂見附駅、ダンス部" /></div>
                </div>
                <div>
                    <label for="school-prefecture">都道府県</label>
                    <select id="school-prefecture" name="prefecture">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Criteria.Prefecture))">全国</option>
                        @foreach (var option in Model.Prefectures)
                        {
                            <option value="@option.Value" selected="@(Model.Criteria.Prefecture == option.Value)">@option.Label（@option.Count）</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="school-ownership">設置区分</label>
                    <select id="school-ownership" name="ownership">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Criteria.Ownership))">すべて</option>
                        <option value="national" selected="@(Model.Criteria.Ownership == "national")">国立</option>
                        <option value="public" selected="@(Model.Criteria.Ownership == "public")">公立</option>
                        <option value="private" selected="@(Model.Criteria.Ownership == "private")">私立</option>
                    </select>
                </div>
                <button class="button button-primary" type="submit">この条件で探す<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" /></svg></button>
            </div>

            <details class="school-advanced-search" open="@Model.HasAdvancedFilters">
                <summary><span>詳細条件</span><small>共学区分・課程・学科・入試情報など</small></summary>
                <div class="school-advanced-grid">
                    <div><label for="school-gender">共学区分</label><select id="school-gender" name="gender"><option value="">すべて</option>@foreach (var option in Model.Genders) { <option value="@option.Value" selected="@(Model.Criteria.Gender == option.Value)">@option.Label（@option.Count）</option> }</select></div>
                    <div><label for="school-attendance">課程</label><select id="school-attendance" name="attendanceType"><option value="">すべて</option>@foreach (var option in Model.AttendanceTypes) { <option value="@option.Value" selected="@(Model.Criteria.AttendanceType == option.Value)">@option.Label（@option.Count）</option> }</select></div>
                    <div><label for="school-department">学科分野</label><select id="school-department" name="department"><option value="">すべて</option>@foreach (var option in Model.DepartmentCategories) { <option value="@option.Value" selected="@(Model.Criteria.DepartmentCategory == option.Value)">@option.Label（@option.Count）</option> }</select></div>
                    <div><label for="school-recruitment">募集状態</label><select id="school-recruitment" name="recruitment"><option value="">すべて</option><option value="excluding-stopped" selected="@(Model.Criteria.Recruitment == "excluding-stopped")">募集停止表示なし</option><option value="stopped" selected="@(Model.Criteria.Recruitment == "stopped")">募集停止中</option></select></div>
                </div>
                <div class="school-availability-row">
                    <fieldset>
                        <legend>掲載情報で絞る</legend>
                        <label><input type="checkbox" name="hasAdmissions" value="true" checked="@Model.Criteria.HasAdmissions" /><span>入試実績あり</span></label>
                        <label><input type="checkbox" name="hasExamSchedule" value="true" checked="@Model.Criteria.HasExamSchedule" /><span>次年度日程あり</span></label>
                        <label><input type="checkbox" name="hasVisitEvents" value="true" checked="@Model.Criteria.HasVisitEvents" /><span>見学情報あり</span></label>
                        <label><input type="checkbox" name="hasSchoolLife" value="true" checked="@Model.Criteria.HasSchoolLife" /><span>部活・学校生活あり</span></label>
                    </fieldset>
                    <div class="school-sort-field">
                        <label for="school-sort">並び替え</label>
                        <select id="school-sort" name="sort"><option value="relevance" selected="@(Model.Criteria.Sort == "relevance")">おすすめ順</option><option value="name" selected="@(Model.Criteria.Sort == "name")">学校名順</option><option value="updated" selected="@(Model.Criteria.Sort == "updated")">情報確認日の新しい順</option><option value="ratio" selected="@(Model.Criteria.Sort == "ratio")">最新年度の最大志願倍率順</option></select>
                    </div>
                </div>
            </details>
        </form>

        @if (activeFilters.Count > 0)
        {
            <div class="school-active-filters" aria-label="選択中の検索条件">
                <span>選択中</span>
                <div>@foreach (var filter in activeFilters) { <a asp-action="Index" asp-all-route-data="@(Routes(filter.Key))" aria-label="@filter.Label を解除">@filter.Label <span aria-hidden="true">×</span></a> }</div>
                <a class="school-clear-filters" asp-action="Index">すべて解除</a>
            </div>
        }

        <div class="school-results-heading" aria-live="polite">
            <div><span>SEARCH RESULT</span><h2>高校検索結果</h2></div>
            <div class="school-result-actions"><p><strong>@Model.Results.TotalCount.ToString("N0")</strong> 件見つかりました</p><a asp-action="Saved">お気に入り <span data-school-favorite-count>0</span>校</a><a data-school-commute-link asp-action="Commute">通学チェック</a></div>
        </div>

        @if (Model.Results.Items.Count == 0)
        {
            <div class="school-empty"><span aria-hidden="true">?</span><h3>条件に合う高校が見つかりませんでした</h3><p>キーワードを短くするか、詳細条件をひとつずつ外して、もう一度お試しください。</p><a asp-controller="Schools" asp-action="Index">条件をすべてクリアする</a></div>
        }
        else
        {
            <div class="school-card-grid">
                @foreach (var school in Model.Results.Items)
                {
                    <article class="school-card">
                        <div class="school-card-tags"><span class="school-tag school-tag-@school.Ownership">@school.OwnershipLabel</span><span class="school-tag school-tag-profile">@school.GenderLabel</span>@if (school.CampusType == "branch") { <span class="school-tag school-tag-branch">分校</span> }@if (school.Tags.Contains("募集停止中")) { <span class="school-tag school-tag-branch">募集停止中</span> }</div>
                        <h3><a asp-action="Details" asp-route-id="@school.Id">@school.Name</a></h3>
                        <p class="school-program-summary">@school.ProgramSummary</p>
                        <p class="school-location"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 18s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z" /><circle cx="10" cy="7" r="2" /></svg>@school.Address</p>
                        @if (school.AccessInfo?.NearestStations.FirstOrDefault() is { } nearestStation) { <p class="school-nearest-station"><span>駅</span><strong>@nearestStation.Name 駅</strong><small>@nearestStation.DistanceLabel</small></p> }
                        <div class="school-card-information" aria-label="掲載している学校情報">@if (school.HasAdmissionResults) { <span>入試実績</span> }@if (school.HasExamSchedules) { <span>次年度日程</span> }@if (school.HasVisitEvents) { <span>見学情報</span> }@if (school.HasSchoolLife) { <span>部活・学校生活</span> }@if (school.LatestApplicationRatio is not null) { <strong>最大志願倍率 @school.LatestApplicationRatio.Value.ToString("0.00")</strong> }</div>
                        <partial name="_SchoolChoiceButtons" model="school" />
                        <div class="school-card-meta"><span>〒@school.PostalCode</span><span>@school.Prefecture</span><span>@school.LastVerifiedAt 確認</span></div>
                        <div class="school-card-footer"><small>ID @school.Id.Replace("wk_", string.Empty).ToUpperInvariant()</small><a asp-action="Details" asp-route-id="@school.Id">学校情報を見る →</a></div>
                    </article>
                }
            </div>

            @if (Model.Results.TotalPages > 1)
            {
                <nav class="school-pagination" aria-label="検索結果のページ送り">
                    @if (Model.Results.Page > 1) { <a asp-action="Index" asp-all-route-data="@(Routes(page: Model.Results.Page - 1))" aria-label="前のページ">←</a> }
                    @foreach (var pageNumber in Model.PageNumbers) { if (pageNumber == Model.Results.Page) { <span aria-current="page">@pageNumber</span> } else { <a asp-action="Index" asp-all-route-data="@(Routes(page: pageNumber))">@pageNumber</a> } }
                    @if (Model.Results.Page < Model.Results.TotalPages) { <a asp-action="Index" asp-all-route-data="@(Routes(page: Model.Results.Page + 1))" aria-label="次のページ">→</a> }
                </nav>
            }
        }

        <aside class="school-data-note">
            <div><span>DATA SOURCE</span><h2>掲載情報について</h2></div>
            <div><p>文部科学省が公開する学校コードと、学校・教育委員会などの公式情報をもとに掲載しています。学科分野は学科名・コース名に含まれる語から分類しており、同じ学校が複数の分野に該当する場合があります。</p><p>志願倍率は最新収録年度における選抜・学科別倍率の最大値で、難易度や合格可能性を示すものではありません。出願など重要な判断の前には、必ず各学校や都道府県の最新情報をご確認ください。</p><a href="https://www.mext.go.jp/b_menu/toukei/mext_01087.html" target="_blank" rel="noopener noreferrer">文部科学省「学校コード」を確認する ↗</a></div>
        </aside>
    </div>
</section>

<partial name="_SchoolCompareTray" />

@section Scripts {
    <script src="~/js/school-shortlist.js" asp-append-version="true"></script>
}
