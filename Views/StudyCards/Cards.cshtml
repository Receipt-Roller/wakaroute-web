@model StudyCardListViewModel
@{
    var subjectName=Model.Subject.Name;
    ViewData["Title"]=$"{subjectName}の学習カード一覧";
    ViewData["Description"]=$"中学校{subjectName}の学習カードを、領域・学年・カード形式・キーワードで検索できます。";
    ViewData["Breadcrumbs"]=new SeoBreadcrumb[]{new("ホーム","/"),new($"{subjectName}の学習カード",$"/study-cards/{Model.Subject.Id}"),new("カード一覧",$"/study-cards/{Model.Subject.Id}/cards")};
    var typeLabels = new Dictionary<string,string>{{"term","用語・定義"},{"formula-unit","公式・単位"},{"experiment","実験"},{"diagram","図と表現"},{"reasoning","理由を説明"},{"pitfall","注意点"},{"map","地図"},{"chronology","時系列"},{"cause-effect","原因と結果"},{"source","資料読解"},{"comparison","比較"}};
}
<section class="study-card-list-hero"><div class="shell"><nav class="breadcrumbs" aria-label="パンくずリスト"><a asp-controller="Home" asp-action="Index">ホーム</a><span>/</span><a asp-action="Index" asp-route-subject="@Model.Subject.Id">@(subjectName)の学習カード</a><span>/</span><span>一覧</span></nav><span class="study-card-eyebrow">REVIEW CARDS</span><h1>@(subjectName)の学習カード</h1><p>カードを押すと答えと解説が開きます。まず頭の中で答えてから確認しましょう。</p></div></section>
<div class="study-card-main"><div class="shell study-card-shell">
<form class="study-card-filters" method="get"><label>領域<select name="domain"><option value="">すべて</option>@foreach(var d in Model.Subject.Domains){<option value="@d.Id" selected="@(d.Id==Model.Domain)">@d.Name</option>}</select></label><label>学年<select name="grade"><option value="">すべて</option>@for(var g=1;g<=3;g++){<option value="@g" selected="@(g==Model.Grade)">中@(g)</option>}</select></label><label>形式<select name="cardType"><option value="">すべて</option>@foreach(var type in Model.Dataset.Items.Where(x=>x.Subject==Model.Subject.Id).Select(x=>x.CardType).Distinct().Order()){<option value="@type" selected="@(type==Model.CardType)">@(typeLabels.GetValueOrDefault(type,type))</option>}</select></label><label class="is-query">キーワード<input name="q" value="@Model.Query" placeholder="例：電流、憲法" /></label><button>絞り込む</button></form>
<p class="study-card-count">@Model.Result.TotalCount 枚のカード</p>
<ol class="study-card-grid">@foreach(var card in Model.Result.Items){var domain=Model.Subject.Domains.First(x=>x.Id==card.Domain);<li><details class="study-flash-card"><summary><span><b>@domain.Name</b><small>中@(card.RecommendedGrade) · @(typeLabels.GetValueOrDefault(card.CardType,card.CardType))</small></span><strong>@card.Prompt</strong><em>答えを見る ＋</em></summary><div><span>ANSWER</span><h2>@card.Answer</h2><p>@card.Explanation</p><ul>@foreach(var tag in card.Tags){<li>#@tag</li>}</ul></div></details></li>}</ol>
@if(Model.Result.TotalPages>1){<nav class="study-card-pagination">@if(Model.Result.Page>1){<a asp-route-subject="@Model.Subject.Id" asp-route-domain="@Model.Domain" asp-route-grade="@Model.Grade" asp-route-cardType="@Model.CardType" asp-route-q="@Model.Query" asp-route-page="@(Model.Result.Page-1)">← 前へ</a>}<span>@Model.Result.Page / @Model.Result.TotalPages</span>@if(Model.Result.Page<Model.Result.TotalPages){<a asp-route-subject="@Model.Subject.Id" asp-route-domain="@Model.Domain" asp-route-grade="@Model.Grade" asp-route-cardType="@Model.CardType" asp-route-q="@Model.Query" asp-route-page="@(Model.Result.Page+1)">次へ →</a>}</nav>}
</div></div>
