@{
    ViewData["Title"] = "会社概要";
    ViewData["Description"] = "ワカルートの運営会社、株式会社レシートローラーについてご案内します。";
    ViewData["Breadcrumbs"] = new SeoBreadcrumb[] { new("ホーム", "/"), new("会社概要", "/company") };
}

<section class="legal-page company-page">
    <div class="shell legal-shell">
        <nav class="breadcrumbs" aria-label="パンくずリスト">
            <a asp-controller="Home" asp-action="Index">ホーム</a><span aria-hidden="true">/</span><span>会社概要</span>
        </nav>
        <header class="legal-header">
            <div class="eyebrow"><span></span>COMPANY</div>
            <h1>会社概要</h1>
            <p>ワカルートは、すべての子どもたちに、理解の順番が見える学習機会を届けるために、株式会社レシートローラーが開発・運営しています。</p>
        </header>

        <div class="company-message">
            <span>OUR PURPOSE</span>
            <h2>学ぶ機会を、もっと平等に。</h2>
            <p>家庭環境や地域にかかわらず、自分がどこでつまずき、次に何を理解すればよいのかがわかること。ワカルートは、高校受験に向かう一人ひとりの「わかるまでの道」を支えます。</p>
        </div>

        <dl class="company-table">
            <div><dt>サービス名</dt><dd>ワカルート（WakaRoute）</dd></div>
            <div><dt>運営会社</dt><dd>株式会社レシートローラー</dd></div>
            <div><dt>代表者</dt><dd>下田 昌平</dd></div>
            <div><dt>所在地</dt><dd>〒389-1226<br />長野県上水内郡飯綱町大字川上1535</dd></div>
            <div><dt>設立</dt><dd>2022年8月</dd></div>
            <div><dt>電話番号</dt><dd><a href="tel:05035620410">050-3562-0410</a></dd></div>
            <div><dt>Webサイト</dt><dd><a class="text-link" href="https://receiptroller.co/ja" target="_blank" rel="noopener noreferrer">receiptroller.co <span aria-hidden="true">↗</span></a></dd></div>
        </dl>

        <aside class="company-platform">
            <div>
                <span>OUR LEARNING PLATFORM</span>
                <h2>MANABU2.COMとの関係</h2>
                <p>ワカルートは、同じ株式会社レシートローラーが運営するMANABU2.COMのSSO・APIなどの学習基盤を利用しています。ワカルートで培った学びと、企業向けの学習・人材育成基盤を、ひとつの技術で支えています。</p>
            </div>
            <a class="button button-primary" href="https://manabu2.com/ja-JP" target="_blank" rel="noopener noreferrer">MANABU2.COMを見る<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5h8v8M15 5l-9 9" /></svg><span class="sr-only">（新しいタブで開きます）</span></a>
        </aside>
    </div>
</section>
